# Supabase public config for Vite.
# Copy this file to web/.env.local and fill values from your own Supabase project.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Tuỳ chọn: thêm origin được phép gọi mạng (connect-src trong Content-Security-Policy),
# cách nhau bằng dấu cách. Supabase và https://n8n.cpc1hn.com đã được thêm sẵn lúc build.
# VITE_CSP_CONNECT_THEM=https://webhook-khac.example.com
