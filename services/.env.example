# Sao chép file này thành .env rồi chỉnh: cp .env.example .env
# (docker compose tự đọc .env; KHÔNG commit .env thật lên git.)

# --- Mạng docker của n8n (để n8n gọi chart-render/gotenberg bằng tên container) ---
# Tìm tên mạng: docker inspect -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}' <container-n8n>
N8N_NETWORK=n8n_default

# --- chart-render ---
# Bearer token bảo vệ endpoint /render. Rỗng = KHÔNG kiểm tra (chỉ dùng trong mạng nội bộ).
# Nếu đặt, phải khai báo cùng giá trị ở credential Header Auth của n8n.
CHART_RENDER_TOKEN=
# Số biểu đồ render song song (1–4). Container nhỏ để 2–4.
RENDER_CONCURRENCY=4
# Cổng publish ra host (chỉ để test/curl trực tiếp; n8n gọi qua tên container 8081).
CHART_RENDER_PORT=8081

# --- Gotenberg (PDF) ---
GOTENBERG_PORT=3000
